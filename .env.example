# Deployment configuration for compose.yaml.
# On the VPS: copy this file to .env and fill in real values.
# No secrets belong in git — this file only documents the shape.

# Full image reference the compose stack runs.
# CD updates this to ghcr.io/d-wack/global:main-<sha> on each release.
APP_IMAGE=ghcr.io/d-wack/global:latest

# Public hostname Caddy serves and provisions TLS for (use a real domain in prod).
APP_DOMAIN=localhost
