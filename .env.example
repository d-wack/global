# Environment configuration for Planet Atlas (deploys on Vercel).
# Copy to .env.local for local dev, or let `vercel env pull .env.local` fill it.
# No secrets belong in git — this file only documents the shape.

# --- Database (required for the Postgres/PostGIS store) ---

# Neon serverless Postgres connection string. Provisioned by the Vercel Neon
# integration and injected into Vercel envs automatically; pull it locally with
# `vercel env pull .env.local`. When unset, the app falls back to the file store
# (offline, UI-only). Run `pnpm db:migrate && pnpm db:seed` after setting it.
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require

# --- Auth0 authentication (required for login in production) ---

# Provisioned by `pnpm auth0:provision` and pulled locally with
# `vercel env pull .env.local`. Set in Vercel for Production only — preview
# deploys have dynamic URLs that aren't registered as Auth0 callbacks and are
# already gated by Vercel SSO, so they run in open mode. Placeholders only here;
# real values live in gitignored .env.local / Vercel env, never in git.

# Auth0 tenant domain (e.g. your-tenant.us.auth0.com or a custom domain).
# AUTH0_DOMAIN=your-tenant.us.auth0.com

# Application (client) ID of the Auth0 Regular Web Application.
# AUTH0_CLIENT_ID=your-auth0-client-id

# Application client secret. Secret — keep out of git.
# AUTH0_CLIENT_SECRET=your-auth0-client-secret

# 32-byte random secret used to encrypt the session cookie
# (generate with `openssl rand -hex 32`). Secret — keep out of git.
# AUTH0_SECRET=your-32-byte-hex-secret

# Public base URL of the app; must match a registered Auth0 callback origin.
# Local dev: http://localhost:3000 — production: https://global-jade-tau.vercel.app
# APP_BASE_URL=http://localhost:3000

# --- Application runtime knobs (non-secret; optional) ---

# Identifying User-Agent for server-side Nominatim geocoding requests (their
# usage policy requires a real contact). Defaults to a project string.
# NOMINATIM_USER_AGENT=PlanetAtlas/0.1 (you@example.com)

# Identifying User-Agent for server-side Wikipedia place-info requests (the
# inspect tool). Wikimedia policy requires a real contact. Defaults to a project
# string.
# WIKIPEDIA_USER_AGENT=PlanetAtlas/0.1 (you@example.com)
