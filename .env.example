# Deployment configuration for compose.yaml.
# On the VPS: copy this file to .env and fill in real values.
# No secrets belong in git — this file only documents the shape.

# Full image reference the compose stack runs.
# CD updates this to ghcr.io/d-wack/global:main-<sha> on each release.
APP_IMAGE=ghcr.io/d-wack/global:latest

# Public hostname Caddy serves and provisions TLS for (use a real domain in prod).
APP_DOMAIN=localhost

# --- Application runtime knobs (non-secret; optional) ---

# Directory for the file-backed events store. Defaults to <cwd>/.data. Under
# Docker this should point at a mounted volume (e.g. /data) for durable storage.
# ATLAS_DATA_DIR=/data

# Identifying User-Agent for server-side Nominatim geocoding requests (their
# usage policy requires a real contact). Defaults to a project string.
# NOMINATIM_USER_AGENT=PlanetAtlas/0.1 (you@example.com)
